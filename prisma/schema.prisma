generator client {
  provider = "prisma-client-js"
  // Build stage has no openssl, so "native" misses 3.0.x, which the runner needs.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../src/schema/zod"
  createInputTypes                 = false
}

model SystemSecret {
  key       String @id
  valueHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Integration settings the admin screen may read back; secrets go to SystemSecret instead.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id            String                  @id @default(uuid())
  email         String?                 @unique
  role          String                  @default("viewer")
  displayName   String
  avatarPath    String?
  createdAt     DateTime                @default(now())
  readStatuses  UserVideoReadStatus[]
  identities    Identity[]
}

model Identity {
  id            String @id @default(uuid())
  userId        String
  provider      String
  providerUid   String
  secretHash    String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
}

model Video {
  id                String            @id @default(uuid())
  title             String
  folderKey         String
  scenePath         String?
  vcsWatchPaths     String[]          @default([])
  revisions         VideoRevision[]   @relation("VideoRevisions")
  latestRevisionNum Int?
  latestRevision    VideoRevision?    @relation("VideoLatestRevision", fields: [id, latestRevisionNum], references: [videoId, revision])
  comments          VideoComment[]
  latestUpdatedAt   DateTime          @default(now())
  deleted           Boolean           @default(false)
  guestVisible      Boolean           @default(false)
  links             Json              @default("[]")

  @@unique([id, latestRevisionNum])
}

model VideoRevision {
  id            String   @id @default(uuid())
  videoId        String
  video          Video    @relation("VideoRevisions", fields: [videoId], references: [id])
  revision       Int
  filePath       String
  uploadedAt     DateTime @default(now())
  deleted        Boolean  @default(false)
  tags           String[] @default([])
  summary        String?
  latestForVideo Video?   @relation("VideoLatestRevision")

  processingJob VideoProcessingJob?
  events      VideoEvent[]
  vcsLinks    VCSRevisionLink[]

  @@unique([videoId, revision])
}

model VideoEventKind {
  id        String   @id @default(uuid())
  label     String   @unique
  events    VideoEvent[]
}

model VideoEvent {
  id              String   @id @default(uuid())
  videoRevisionId String
  kindId          String
  startMs         Int
  endMs           Int
  data            String
  contentId       String?
  seq             Int               @default(0)
  links           Json              @default("[]")
  createdAt       DateTime          @default(now())

  videoRevision VideoRevision @relation(fields: [videoRevisionId], references: [id], onDelete: Cascade)
  kind          VideoEventKind @relation(fields: [kindId], references: [id], onDelete: Restrict)

  @@index([videoRevisionId])
  @@index([kindId])
  @@index([videoRevisionId, kindId, startMs])
}

model VideoProcessingJob {
  id              String   @id @default(uuid())
  videoRevisionId String  @unique
  status          JobStatus @default(pending)
  createdAt       DateTime @default(now())

  videoRevision VideoRevision @relation(fields: [videoRevisionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VideoComment {
  id                String          @id @default(uuid())
  video             Video           @relation(fields: [videoId], references: [id])
  videoId           String
  videoRevNum       Int
  userName          String
  userEmail         String          @default("")
  comment           String
  time              Float
  issueId           String?
  notifiedProviders String[]        @default([])
  drawingPath       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deleted           Boolean         @default(false)
  thumbsUp          Int             @default(0)
}

model SlackMessage {
  id              String         @id @default(uuid())
  channelId       String   
  ts              String   
  createdAt       DateTime       @default(now())
  videoCommentId  String?        @unique

  threadMessages SlackThreadMessage[]
}

model SlackThreadMessage {
  id              String   @id @default(uuid())
  slackMessage    SlackMessage @relation(fields: [slackMessageId], references: [id])
  slackMessageId  String

  ts              String
  createdAt       DateTime @default(now())
}

model UserVideoReadStatus {
  id                String   @id @default(uuid())
  userId            String?
  user              User?   @relation(fields: [userId], references: [id])

  videoId           String
  lastReadCommentId String?
  updatedAt         DateTime @updatedAt

  @@unique([userId, videoId])
}

model UploadSession {
  id            String            @id @default(uuid())
  storageKey    String
  storage       UploadStorageType
  title         String
  folderKey     String
  scenePath     String?
  vcsWatchPaths String[]          @default([])
  nextRev       Int
  createdAt     DateTime          @default(now())
}

enum UploadStorageType {
  local
  s3
  nextCloud
}

enum JobStatus {
  pending
  running
  succeeded
  failed
}

model VCSConfig {
  id        String   @id @default(uuid())
  label     String
  provider  String
  config    Json
  tokenKey  String?
  branch    String   @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisionLinks VCSRevisionLink[]
}

model VCSRevisionLink {
  id              String   @id @default(uuid())
  videoRevisionId String
  videoRevision   VideoRevision @relation(fields: [videoRevisionId], references: [id])
  vcsConfigId     String
  vcsConfig       VCSConfig @relation(fields: [vcsConfigId], references: [id])

  rangeFrom     DateTime?
  rangeTo       DateTime?
  fetchedAt     DateTime?
  summary       String?
  /// [{ cachedMergeId: string, relevance: string, relevanceReason: string }]
  mergeResults  Json?
  /// [{ cachedCommitId: string, relevance: string, relevanceReason: string }]
  commitResults Json?

  @@unique([videoRevisionId, vcsConfigId])
}

model VCSCachedMerge {
  id             String    @id @default(uuid())
  /// 外部ID（PR番号など）
  externalId     String
  /// プロバイダー識別子（例: "github:owner/repo"）
  repoName       String
  title          String
  description    String?
  author         String
  mergedAt       DateTime
  url            String
  labels         String[]
  /// fetchMergeFiles() の結果。filesFetchedAt IS NULL = 未フェッチ
  files          String[]  @default([])
  filesFetchedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([externalId, repoName])
}

model VCSFetchedRange {
  repoName  String
  /// UTC midnight (start of UTC day)
  date      DateTime
  fetchedAt DateTime @default(now())

  @@unique([repoName, date])
}

model VCSCachedCommit {
  id             String    @id @default(uuid())
  hash           String
  repoName       String
  shortHash      String
  message        String
  author         String
  committedAt    DateTime
  url            String?
  /// fetchCommitFiles() の結果。filesFetchedAt IS NULL = 未フェッチ
  files          String[]  @default([])
  filesFetchedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([hash, repoName])
}
