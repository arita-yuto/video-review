FROM node:24-slim AS deps
WORKDIR /app

# Prisma picks its engines by the OpenSSL it finds at install, so the runner's OpenSSL is here
# too; otherwise migrating on start fetches an engine from the internet and fails offline.
RUN apt-get update \
 && apt-get install -y openssl \
 && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

FROM deps AS builder
WORKDIR /app

ENV CI_BUILD=true

COPY . .
RUN npm run prisma:generate
RUN npm run build


FROM node:24-slim AS runner
WORKDIR /app

RUN apt-get update \
 && apt-get update -y && apt-get install -y openssl \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

EXPOSE 3000

# compose starts this once the database accepts connections (the db healthcheck).
CMD ["sh", "-c", "npm run prisma:deploy && exec npm run start"]
