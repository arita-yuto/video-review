    "type": "module",
    "scripts": {
        "dev": "next dev --turbopack -p 3489",
        "build": "npx tsx build.ts",
        "start": "next start -p 3489",
        "test": "set -a && . ./.env.test && set +a && npx tsx run-test.ts",
        "test:hono": "set -a && . ./.env.test && set +a && npx tsx run-test.ts tests/server",
        "test:e2e": "set -a && . ./.env.test && set +a && npx tsx run-e2e.ts",
        "test:e2e:install": "npx playwright install chromium --with-deps",
        "video-processing:build": "npx tsx integrations/video-processing/build.ts",
        "video-processing:run": "node integrations/video-processing/dist/main-local.js",
        "mcp:eval": "npx tsx tests/smoke/mcp-eval.ts",
        "llm:check": "set -a && . ./.env && set +a && LLM_SMOKE=1 npx vitest run tests/smoke",
        "prisma:deploy": "npx prisma migrate deploy",
        "prisma:generate": "npx prisma generate",
        "prisma:migration": "npx prisma migrate dev --name",
        "prisma:seed": "npx tsx prisma/seed.ts",
        "prisma:seed:eval": "npx tsx prisma/seed-eval.ts",
        "lint": "eslint src"
    },
